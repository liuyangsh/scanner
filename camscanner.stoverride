name: 扫描全能王 解锁黄金会员
desc: 扫描全能王 解锁黄金会员
icon: https://clashios.app/static/icon-120x120.png
http:
  mitm:
    - "*.camscanner.com"
    - "*.intsig.net"
  script:
    - match: ^https:\/\/.*\.(intsig\.net|camscanner\.com)
      name: CamScanner_8
      type: response
      require-body: true
      max-size: -1
      timeout: 60
script-providers:
  CamScanner_8:
    url: https://raw.githubusercontent.com/chxm1023/Rewrite/main/CamScanner.js
    interval: 86400
category: 解锁
date: 2023-08-19 13:23:01
